{% assign news_size = site.news | size %}
<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% if page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% elsif include.limit and site.announcements.limit %}
      {% assign news_limit = site.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    <div
      class="table-responsive"
      {% if (page.announcements.scrollable or (include.limit and site.announcements.scrollable)) and news_size > news_limit %}
      {% assign scroll_height = site.announcements.scroll_height | default: '400px' %}
      style="max-height: {{ scroll_height }}; overflow-y: auto;"
      {% endif %}>
      <table class="table table-sm table-borderless">
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 10%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.icon %}
                {% case item.icon %}
                  {% when 'fa-solid fa-coins' %}{% assign icon_color = '#e0a800' %}
                  {% when 'fa-solid fa-trophy' %}{% assign icon_color = '#f0b400' %}
                  {% when 'fa-solid fa-file-lines' %}{% assign icon_color = '#1e88e5' %}
                  {% when 'fa-solid fa-users' %}{% assign icon_color = '#2e9e4f' %}
                  {% when 'fa-solid fa-microphone' %}{% assign icon_color = '#e53935' %}
                  {% when 'fa-solid fa-user-tie' %}{% assign icon_color = '#6d4c9f' %}
                  {% when 'fa-solid fa-flask' %}{% assign icon_color = '#00897b' %}
                  {% else %}{% assign icon_color = 'var(--global-theme-color)' %}
                {% endcase %}
              {% endif %}
              <div style="display: flex; align-items: baseline; gap: 0.4em;">
                {% if item.icon %}<i class="{{ item.icon }} fa-fw" style="color: {{ icon_color }}; flex-shrink: 0;"></i>{% endif %}
                <div>
                  {% if item.inline %}
                    {{ item.content | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% endif %}
                </div>
              </div>
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>